# ── libraries ────────────────────────────────────────────────────────────
if (!requireNamespace("readxl", quietly = TRUE)) install.packages("readxl")
if (!requireNamespace("readr",  quietly = TRUE)) install.packages("readr")
if (!requireNamespace("dplyr",  quietly = TRUE)) install.packages("dplyr")
library(readxl)
library(readr)
library(dplyr)
# ── file paths ───────────────────────────────────────────────────────────
xlsx_path <- "C:/Users/teddy/Desktop/testcsv.xlsx"   # use forward slashes
csv_path  <- "C:/Users/teddy/Desktop/testcsv.csv"
# ── read the two versions of the dataset ────────────────────────────────
dat_xlsx <- read_xlsx(xlsx_path)
dat_csv  <- read_csv(csv_path, show_col_types = FALSE)
# ── helper to run a model and keep Antennaria row(s) ────────────────────
pick_antennaria <- function(df, model_fun, label){
out <- model_fun(df)
out %>%
filter(grepl("Antennaria\\s+dioica", species, ignore.case = TRUE)) %>%
select(species, cScore, sScore, rScore,
cPercent, sPercent, rPercent) %>%
mutate(from = label)
}
# ── run both models on both files ───────────────────────────────────────
res <- bind_rows(
pick_antennaria(dat_xlsx, morphoPhys, "xlsx + morphoPhys"),
pick_antennaria(dat_csv,  morphoPhys, "csv  + morphoPhys"),
pick_antennaria(dat_xlsx, morphotwo,   "xlsx + morphotwo"),
pick_antennaria(dat_csv,  morphotwo,   "csv  + morphotwo")
)
print(res)
runApp()
