# Minimal, test-ready version with FS and SLA optional
morphotwo <- function(data) {
# ---------- helper to standardise column names ----------
renameColumnsMorphophys <- function(df) {
dict <- list(
species = c("^species$", "^sp\\.$", "^sp$", "^taxon$", "^species[._ ]?name$", "^taxon[._ ]?name$"),
CH      = c("^canopy[._ ]?height$", "^CH$"),
LDMC    = c("^leaf[._ ]?dry[._ ]?matter[._ ]?content$", "^LDMC$"),
FP      = c("^flowering[._ ]?period$", "^FP$"),
LS      = c("^lateral[._ ]?spread$", "^LS$"),
LDW     = c("^leaf[._ ]?dry[._ ]?weight$", "^LDW$"),
PN      = c("^net[._ ]?photosynthesis$", "^PN$"),
RD      = c("^dark[._ ]?respiration[._ ]?rate$", "^respiration[._ ]?rate$", "^RD$"),
LNC     = c("^leaf[._ ]?nitrogen[._ ]?content$", "^LNC$"),
LCC     = c("^leaf[._ ]?carbon[._ ]?concentration$", "^LCC$"),
FS      = c("^flowering[._ ]?start$", "^FS$"),           # optional
SLA     = c("^specific[._ ]?leaf[._ ]?area$", "^SLA$")   # optional
)
for (nm in names(dict)) {
hits <- grep(paste(dict[[nm]], collapse = "|"),
names(df), ignore.case = TRUE, value = TRUE)
if (length(hits) > 0) names(df)[names(df) %in% hits] <- nm
}
df
}
# ---------- rename & basic checks ----------
data <- renameColumnsMorphophys(data)
req <- c("species", "CH", "LDMC", "FP", "LS",
"LDW", "PN", "RD", "LNC", "LCC")
if (!all(req %in% names(data))) {
stop("Input is missing one or more mandatory columns: ",
paste(setdiff(req, names(data)), collapse = ", "))
}
# add empty optional cols if absent so mutate() doesn’t fail
if (!"FS"  %in% names(data)) data$FS  <- NA_real_
if (!"SLA" %in% names(data)) data$SLA <- NA_real_
# ---------- trait transforms ----------
library(dplyr)
calc <- data %>%
mutate(
chT  = ifelse(CH  > 0, log(CH),           NA),
ldmcT= ifelse(LDMC> 0, sqrt(LDMC),        NA),
fpT  = FP,
lsT  = LS,
ldwT = ifelse(LDW > 0, log(LDW) + 3,      NA),
pnT  = ifelse(PN  > 0, sqrt(PN),          NA),
rdT  = ifelse(RD  > 0, sqrt(RD),          NA),
lncT = ifelse(LNC > 0, sqrt(LNC),         NA),
lccT = ifelse(LCC > 0, sqrt(LCC),         NA)
)
# ---------- PCA scores (fixed loadings) ----------
calc <- calc %>%
mutate(
pca1 =  3.52173 + 0.21179*chT -0.26218*ldmcT +0.19528*fpT
-0.04086*lsT +0.00836*ldwT +0.32013*pnT +1.00069*rdT
+0.25930*lncT -0.38065*lccT,
pca2 = -15.44964 +0.58035*chT +0.42225*ldmcT -0.05119*fpT
+0.21762*lsT +0.22002*ldwT +0.02368*pnT +0.35671*rdT
+0.27781*lncT +0.28015*lccT
)
# ---------- projection to CSR axes ----------
calc <- calc %>%
mutate(
cScore = (pca1*0.032 + pca2*1.14)  / 1.14,
sScore = (pca1*-0.842 + pca2*-0.678) / 1.081,
rScore = (pca1*1.091 + pca2*-0.661)  / 1.276
) %>%
mutate(
cPercent = 100*(cScore + 2) / (cScore + sScore + rScore + 6),
sPercent = 100*(sScore + 2) / (cScore + sScore + rScore + 6),
rPercent = 100*(rScore + 2) / (cScore + sScore + rScore + 6)
) %>%
mutate(across(c(cPercent,sPercent,rPercent), ~pmax(0,.)))
# ---------- 19-type classification ----------
lattice <- data.frame(
strategy = c("C","C/CR","C/CS","CR","C/CSR","CS","CR/CSR","CS/CSR",
"R/CR","CSR","S/CS","R/CSR","S/CSR","R","SR/CSR",
"S","R/SR","S/SR","SR"),
c = c( 2,1,1,0,1,0,0,0,-1, 0,-1,-1,-1,-2,-1,-2,-2,-2,-2),
s = c(-2,-2,-1,-2,-1,0,-1,0,-2, 0, 1,-1, 1,-2, 0, 2,-1, 1, 0),
r = c(-2,-1,-2, 0,-1,-2, 0,-1, 1, 0,-2, 1,-1, 2, 0,-2, 1,-1, 0)
)
classify <- function(c,s,r) {
d <- sqrt((lattice$c-c)^2 + (lattice$s-s)^2 + (lattice$r-r)^2)
lattice$strategy[which.min(d)]
}
calc <- calc %>%
rowwise() %>%
mutate(strategyClass = classify(cScore,sScore,rScore)) %>%
ungroup()
# ---------- output ----------
cbind(data,
calc %>% select(cScore,sScore,rScore,
cPercent,sPercent,rPercent,strat=strategyClass))
}
dat <- read.csv("C:/Users/teddy/Desktop/testcsv.csv",
stringsAsFactors = FALSE)
out <- morphotwo(dat)
write.csv(out, "C:/Users/teddy/Desktop/testcsv_with_CSR.csv",
row.names = FALSE)
compare_test <- function(df) {
old <- morphoPhys(df)      # your unedited function
new <- morphotwo(df)       # the edited one
same <- all.equal(old[, c("cScore","sScore","rScore")],
new[, c("cScore","sScore","rScore")],
tolerance = 1e-10)
print(same)
if (!isTRUE(same)) {
cat("Head of numeric differences:\n")
print(head(old[, c("cScore","sScore","rScore")] -
new[, c("cScore","sScore","rScore")]))
}
}
compare_test(dat)   # dat is the data frame you just read
runApp()
