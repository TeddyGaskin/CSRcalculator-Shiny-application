reconstructLfwLdw <- function(data) {
requiredCols <- c("SLA", "LA", "LDMC")
if (!all(requiredCols %in% names(data))) {
stop("Data must contain SLA, LA, and LDMC columns.")
}
data <- data %>%
mutate(
LDW = LA / SLA,
LFW = (LDW * 100) / LDMC
)
return(data)
}
exampleData <- reconstructLfwLdw(novakData)
write.csv(exampleData, "D:/PhD/CSR/exampleData.csv", row.names = FALSE)
