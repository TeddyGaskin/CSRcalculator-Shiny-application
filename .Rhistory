# Load required package
library(CSRcalculator)
# Load the dataset
dataPath <- "D:/PhD/CSR/NovakovskiyEtAlSupp.csv"
traits <- read.csv(dataPath, stringsAsFactors = FALSE)
# Rename PH to CH for compatibility
colnames(traits)[colnames(traits) == "PH"] <- "CH"
# Run each CSR model
stratefyResults  <- strateFy(traits, calcSLA = FALSE, calcLDMC = FALSE)
morphoResults    <- morphoPhys(traits)
hodgsonResults   <- hodgson(traits)
# Target species
speciesName <- "Tanacetum bipinnatum"
# Function to extract CSR scores from model output
getSpeciesCSR <- function(results, speciesName) {
row <- results[results$species == speciesName, c("cPercent", "sPercent", "rPercent")]
if (nrow(row) == 0) {
return(data.frame(message = paste("Species not found in", deparse(substitute(results)))))
}
return(row)
}
# Get CSR scores for the species from each model
stratefyCSR <- getSpeciesCSR(stratefyResults, speciesName)
morphoCSR   <- getSpeciesCSR(morphoResults, speciesName)
hodgsonCSR  <- getSpeciesCSR(hodgsonResults, speciesName)
# Display results
cat("CSR scores for", speciesName, "\n")
cat("\nStrateFy:\n")
print(stratefyCSR)
cat("\nMorphoPhys:\n")
print(morphoCSR)
cat("\nHodgson:\n")
print(hodgsonCSR)
runApp()
shiny::runApp()
